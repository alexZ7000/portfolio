{
    "name": "portfolio",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --serve-path /",
        "prebuild": "node tools/generate-webp.mjs",
        "build": "ng build --base-href /",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:portfolio": "node dist/portfolio/server/server.mjs",
        "preview": "node dist/portfolio/server/server.mjs",
        "predeploy": "node tools/generate-webp.mjs",
        "deploy": "ng deploy --base-href=/",
        "generate:webp": "node tools/generate-webp.mjs",
        "format": "npx prettier . --write"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "packageManager": "npm@11.4.2",
    "dependencies": {
        "@angular/common": "^21.2.4",
        "@angular/compiler": "^21.2.4",
        "@angular/core": "^21.2.4",
        "@angular/forms": "^21.2.4",
        "@angular/platform-browser": "^21.2.4",
        "@angular/platform-server": "^21.2.4",
        "@angular/router": "^21.2.4",
        "@angular/ssr": "^21.2.4",
        "@fortawesome/angular-fontawesome": "^4.0.0",
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-regular-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@ngx-translate/core": "^17.0.0",
        "@ngx-translate/http-loader": "^17.0.0",
        "express": "^5.1.0",
        "gsap": "^3.14.2",
        "lucide-angular": "^0.563.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.4",
        "@angular/cli": "^21.2.4",
        "@angular/compiler-cli": "^21.2.4",
        "@types/express": "^5.0.1",
        "@types/node": "^20.17.19",
        "jsdom": "^27.1.0",
        "sharp": "^0.34.5",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
